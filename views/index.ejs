                <span class="skill-tag">Tableau</span>
                <span class="skill-tag">Jupyter Notebook</span>
              </div>
            </div>
          </div>

          <!-- DevOps & Tools -->
          <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="300">
