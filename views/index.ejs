<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="icon" type="image/x-icon" href="/assets/icontitle.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <!-- AOS CSS -->
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css"
      rel="stylesheet"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <!-- Meteor & Ambient Glow Background -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>
    <div class="meteor-container"></div>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
      <div class="container">
        <a class="navbar-brand" href="#home">
          <span class="brand-text">Apileee</span>
          <span class="brand-dot"></span>
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link active" href="#home">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#about">About</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#experience">Experience</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#skills">Skills</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#projects">Projects</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#contact">Contact</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Home / Hero Section -->
    <section id="home" class="hero-section">
      <div class="container h-100">
        <div class="row h-100 align-items-center">
          <div class="col-lg-7" data-aos="fade-right" data-aos-duration="1000">
            <div class="hero-content">
              <div class="hero-badge mb-3">
                <span class="pulse-indicator"></span>
                <span>Web Developer &amp; Software Engineer</span>
              </div>
              <h1 class="hero-title">
                Halo, Saya <span class="highlight-text">Arafil Azmi</span>
              </h1>
              <p class="hero-subtitle">
                Full-Stack Web Developer | Data Science &amp; Machine Learning
              </p>
              <p class="hero-description">
                "Everybody in this country should learn how to program a
                computer, because it teaches you how to think."
                <span class="quote-author">— Steve Jobs</span>
              </p>
              <div class="hero-buttons">
                <button class="btn btn-primary btn-lg" onclick="downloadCV()">
                  <i class="fas fa-download me-2"></i> Download CV
                </button>
                <a href="#contact" class="btn btn-outline-primary btn-lg">
                  <i class="fas fa-paper-plane me-2"></i> Hubungi Saya
                </a>
              </div>
            </div>
          </div>
          <div class="col-lg-5" data-aos="fade-left" data-aos-duration="1000">
            <div class="hero-image">
              <div class="profile-glow-ring"></div>
              <div class="profile-circle">
                <div class="profile-circle-inner">
                  <img
                    src="/assets/img/profile.jpg"
                    alt="Arafil Azmi"
                    class="profile-photo"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about-section">
      <div class="container">
        <div class="section-title text-center" data-aos="fade-up">
          <span class="section-badge">Profil</span>
          <h2>About Me</h2>
          <div class="title-underline"></div>
        </div>
        <div data-aos="fade-up" data-aos-delay="100">
          <div class="about-box">
            <div class="about-icon mb-3">
              <i class="fas fa-terminal"></i>
            </div>
            <h3>Tentang Saya</h3>
            <p class="text-center">
              Saya adalah lulusan Informatika dari <strong>Universitas Negeri Padang</strong> dengan fokus kuat pada <strong>Web Development</strong> dan <strong>Software Engineering</strong>. Berpengalaman dalam mengembangkan dan mengelola aplikasi web berskala enterprise, merancang arsitektur backend yang tangguh, integrasi basis data, serta troubleshooting isu teknis secara presisi.
            </p>
            <p class="text-center">
              Memiliki kemampuan analitis dan problem solving yang kuat, diperkaya pemahaman dalam analisis data, machine learning, dan kecerdasan buatan melalui pengerjaan proyek akademik maupun personal. Saya selalu bersemangat untuk berkontribusi pada pengembangan perangkat lunak dunia nyata sambil terus mengasah kapabilitas teknis dan pertumbuhan profesional.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Work Experience Section -->
    <section id="experience" class="experience-section">
      <div class="container">
        <div class="section-title text-center" data-aos="fade-up">
