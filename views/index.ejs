    <!-- Projects Section -->
    <section id="projects" class="projects-section">
      <div class="container">
        <div class="section-title text-center" data-aos="fade-up">
          <span class="section-badge">Karya &amp; Implementasi</span>
          <h2>Featured Projects</h2>
          <div class="title-underline"></div>
        </div>

        <!-- Project Filters -->
        <div class="project-filters text-center mb-5" data-aos="fade-up">
          <button class="filter-btn active" data-filter="all">All Projects</button>
          <button class="filter-btn" data-filter="enterprise-web">Enterprise &amp; Web</button>
          <button class="filter-btn" data-filter="data-ml">Data Science &amp; ML</button>
        </div>

        <div class="row g-4" id="projectsContainer">
          <!-- Featured Project 1: Enterprise GIS & DAS (NEW!) -->
          <div
            class="col-md-6 col-lg-4 project-item"
            data-category="enterprise-web"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <div class="project-card featured-project">
              <div class="project-image">
                <img
                  src="/assets/img/EnterpriseGIS.png"
                  alt="Enterprise GIS & DAS - KPN Plantations"
                  class="img-fluid"
                />
                <div class="project-overlay">
                  <div class="project-buttons">
                    <span class="text-light"><i class="fas fa-lock me-1"></i> Private Repository</span>
                  </div>
                </div>
              </div>
              <div class="project-info">
                <div class="project-header">
                  <h5>Enterprise GIS &amp; Digital Approval System (DAS)</h5>
                  <span class="badge badge-enterprise">Enterprise</span>
                </div>
                <p>
                  Mengembangkan dan meningkatkan fitur aplikasi enterprise untuk manajemen pengguna, kontrol akses (access control), dan konfigurasi persetujuan digital di <strong>KPN Plantations</strong>. Mengintegrasikan antarmuka frontend, backend services, dan operasi basis data, serta mengoptimalkan performa pemuatan data dan troubleshooting isu teknis.
                </p>
                <div class="project-tech">
                  <span class="tech-badge">C#</span>
                  <span class="tech-badge">ASP.NET Web Forms</span>
                  <span class="tech-badge">C# Web Services</span>
                  <span class="tech-badge">SQL Stored Procedures</span>
                  <span class="tech-badge">Enterprise GIS</span>
                  <span class="tech-badge">Git &amp; GitHub</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Project 2: Church Scheduling System -->
          <div
            class="col-md-6 col-lg-4 project-item"
            data-category="enterprise-web"
            data-aos="fade-up"
            data-aos-delay="150"
          >
            <div class="project-card">
              <div class="project-image">
                <img
                  src="/assets/img/Gereja.png"
                  alt="Management Gereja"
                  class="img-fluid"
                />
                <div class="project-overlay">
                  <div class="project-buttons">
                    <a
                      href="http://genetika.skripsian.site/"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-sm btn-light"
                    >
                      <i class="fas fa-external-link-alt me-1"></i> Demo
                    </a>
                    <a
                      href="https://github.com/Apileeee/Management_Gereja"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-sm btn-light"
                    >
                      <i class="fab fa-github me-1"></i> Code
                    </a>
                  </div>
                </div>
              </div>
              <div class="project-info">
                <div class="project-header">
                  <h5>Church Stage Service Scheduling System</h5>
